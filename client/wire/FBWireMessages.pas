function FindMessageIndex(aCode: cardinal; var aIndex: integer): boolean;
var lo, hi, mid: integer;
begin
  Result := false;
  lo := 0;
  hi := MessageCount - 1;
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    if MessageCodes[mid] = aCode then
    begin
      aIndex := mid;
      Exit(true);
    end;
    if MessageCodes[mid] < aCode then
      lo := mid + 1
    else
      hi := mid - 1;
  end;
end;

function FindEngineMessage(aCode: cardinal; var aFormat: AnsiString): boolean;
var idx: integer;
begin
  Result := FindMessageIndex(aCode,idx);
  if Result then
    aFormat := MessageTexts[idx];
end;

function EngineMessageSQLCode(aCode: cardinal): integer;
var idx: integer;
begin
  if FindMessageIndex(aCode,idx) then
    Result := MessageSQLCodes[idx]
  else
    Result := NoSQLCode;
end;

